# Copy this file to `.env` and fill in the values, then restart `npm run dev`.
# cp .env.example .env

# ---- Database (REQUIRED) ----
# Neon Postgres connection string. Find it in the Neon dashboard (https://console.neon.tech)
# or in your Vercel project's Environment Variables (it's the value production already uses).
# Without this, the site renders with MOCK data and dev logs a Prisma "Invalid URL" error.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ---- Site URL (used for SEO canonical/OG/sitemap/robots) ----
# Local dev: http://localhost:3000   |   Production: https://www.sabinksanthosh.me
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Admin auth (REQUIRED for /admin login) ----
# A long random string used to sign JWT session cookies. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# ---- Contact form email over SMTP (needed for /contact to actually send) ----
# For Gmail use an App Password (https://myaccount.google.com/apppasswords), NOT your login password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="sabinksanthosh6@gmail.com"
SMTP_PASS="your-smtp-app-password"

# ---- Analytics (OPTIONAL) ----
# Leave blank to disable — the GA/Pixel scripts only load when these are set.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_FB_PIXEL_ID=""
